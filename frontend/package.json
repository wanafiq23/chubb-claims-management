{
  "name": "chubb-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host localhost --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.spec.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed"
  },
  "engines": { "node": "^20.19.0 || ^22.12.0 || ^24.0.0" },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.56.1",
    "typescript": "~5.9.3"
  }
}
